# Raw nbadb SQLite is multi-GB and must never enter the repo (GitHub 100MB limit).
# Only the slim gzipped extracts under source-data/ are committed.
*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Transient resume-cache for fetch_espn_round_labels.py (not a committed extract).
source-data/_round_labels_gamenote_cache.json

# Raw HTML cache for fetch_nbra_bios.py (local scraping cache, not a source
# extract -- the parsed output is source-data/nbra_bios.csv).
source-data/_nbra_raw/

# Page + JS bundle cache for probe_assignments_source.py (local scraping cache
# so the investigation can iterate without refetching; not a source extract).
source-data/_assignments_raw/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
nbra_out.txt 
calls_out.txt
pbp_out.txt

# Play-by-play archives downloaded by extract_referee_calls.py and
# probe_nba_data_2025.py from shufinskiy/nba_data. Tens of MB of tar.xz, and
# reproducible from the published index -- cache, not a source extract.
source-data/_nba_data_cache/

# Raw Last Two Minute report CSV (53MB) pulled by extract_l2m.py from
# atlhawksfanatic/L2M. Reproducible from that repo; the slim per-game and
# per-crew extracts are what this repo commits.
source-data/_l2m_cache/
source-data/*.bak
